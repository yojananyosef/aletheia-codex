{
  "name": "bibleol",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.16.1",
  "engines": {
    "node": ">=22.23.4"
  },
  "scripts": {
    "dev": "pnpm --filter @bibleol/web dev",
    "build": "pnpm --filter @bibleol/web build",
    "start": "pnpm --filter @bibleol/web start",
    "preview": "pnpm --filter @bibleol/web preview",
    "check": "pnpm -r check",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "pnpm -r test",
    "test:e2e": "pnpm --filter @bibleol/web test:e2e",
    "data:import": "python3 scripts/import_legacy.py",
    "data:sync": "python3 scripts/sync_corpora.py",
    "data:verify": "python3 scripts/verify_corpora.py"
  },
  "devDependencies": {
    "@playwright/test": "1.57.0",
    "eslint": "^10.13.0",
    "eslint-plugin-astro": "^3.2.1",
    "prettier": "^3.9.10",
    "prettier-plugin-astro": "^1.1.2",
    "typescript": "5.9.3",
    "typescript-eslint": "^8.72.1"
  }
}
