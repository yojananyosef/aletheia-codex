{
  "name": "aletheia-codex",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.18.0",
  "engines": {
    "node": ">=26"
  },
  "scripts": {
    "dev": "pnpm --filter @aletheia-codex/web dev",
    "build": "pnpm --filter @aletheia-codex/web build",
    "start": "pnpm --filter @aletheia-codex/web start",
    "preview": "pnpm --filter @aletheia-codex/web preview",
    "export:static": "node scripts/export-static.mjs --start-server --out dist-static",
    "deploy:vercel": "bash scripts/deploy-vercel.sh",
    "check": "pnpm -r check",
    "lint": "biome lint .",
    "lint:fix": "biome lint --write .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "pnpm -r test",
    "test:e2e": "pnpm --filter @aletheia-codex/web test:e2e",
    "db:migrate": "node scripts/db-migrate.mjs",
    "db:status": "node scripts/db-migrate.mjs --status",
    "data:import": "python3 scripts/import_legacy.py",
    "data:lexicons": "python3 scripts/import_lexicons.py",
    "data:sync": "python3 scripts/sync_corpora.py",
    "data:verify": "python3 scripts/verify_corpora.py"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.6",
    "@playwright/test": "1.65.0",
    "@types/pg": "^8.23.1",
    "pg": "^8.23.1",
    "prettier": "^3.9.10",
    "prettier-plugin-astro": "^1.1.2",
    "typescript": "7.0.2"
  }
}
