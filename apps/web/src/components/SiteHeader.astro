---
import { t } from "../i18n";
import { authAvailable } from "../lib/auth/config";
---

<header class="site-header">
  <div class="wrap site-header__inner">
    <a class="brand" href="/" aria-label={t.appName}>
      <span class="brand__name">
        Bible<span class="brand__accent">OL</span>
      </span>
      <span class="brand__tagline">{t.tagline}</span>
    </a>
    <nav class="site-nav" aria-label={t.navLabel}>
      <a class="site-nav__link" href="/#ediciones">
        {t.navEditions}
      </a>
      <a class="site-nav__link" href="/#como-leer">
        {t.navReading}
      </a>
      {authAvailable() ? (
        <a class="site-nav__link site-nav__cta" href="/cuenta">
          {t.navAccount}
        </a>
      ) : null}
    </nav>
  </div>
</header>
