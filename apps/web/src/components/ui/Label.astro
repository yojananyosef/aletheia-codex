---
import { cn } from "../../lib/cn";

interface Props {
  for?: string;
  class?: string;
  [key: string]: unknown;
}

const { for: htmlFor, class: className, ...rest } = Astro.props;
---

<label
  for={htmlFor}
  class={cn(
    "text-xs leading-none font-medium text-muted-foreground",
    className,
  )}
  {...rest}
>
  <slot />
</label>
