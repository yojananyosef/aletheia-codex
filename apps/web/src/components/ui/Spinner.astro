---
import { cn } from "../../lib/cn";

interface Props {
  size?: number;
  class?: string;
  label?: string;
}

const { size = 16, class: className, label } = Astro.props;
---

<svg
  xmlns="http://www.w3.org/2000/svg"
  width={size}
  height={size}
  viewBox="0 0 24 24"
  fill="none"
  stroke="currentColor"
  stroke-width="2.5"
  stroke-linecap="round"
  class={cn("animate-spin", className)}
  role={label ? "status" : undefined}
  aria-label={label}
  aria-hidden={label ? undefined : "true"}
  focusable="false"
>
  <path d="M21 12a9 9 0 1 1-6.219-8.56"></path>
</svg>
