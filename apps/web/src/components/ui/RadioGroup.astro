---
import { cn } from "../../lib/cn";

type Columns = 1 | 2 | 3;

interface Props {
  legend?: string;
  columns?: Columns;
  class?: string;
  [key: string]: unknown;
}

const { legend, columns = 1, class: className, ...rest } = Astro.props;

const columnClasses: Record<Columns, string> = {
  1: "",
  2: "min-[700px]:grid-cols-2",
  3: "min-[700px]:grid-cols-3",
};
---

<fieldset class={cn("min-w-0 border-0 p-0", className)} {...rest}>
  {legend ? (
    <legend class="p-0 text-[0.6rem] font-semibold tracking-[0.1em] text-muted-foreground uppercase">
      {legend}
    </legend>
  ) : null}
  <div class={cn("mt-2.5 grid gap-2.5", columnClasses[columns])}>
    <slot />
  </div>
</fieldset>
