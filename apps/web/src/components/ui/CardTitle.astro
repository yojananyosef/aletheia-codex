---
import { cn } from "../../lib/cn";

interface Props {
  class?: string;
  [key: string]: unknown;
}

const { class: className, ...rest } = Astro.props;
---

<h3
  class={cn(
    "font-display text-xl leading-tight font-medium tracking-[-0.015em] text-foreground",
    className,
  )}
  {...rest}
>
  <slot />
</h3>
