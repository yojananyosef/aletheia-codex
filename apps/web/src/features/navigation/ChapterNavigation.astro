---
import type { Book, CorpusSummary } from "@bibleol/contracts";
import Button from "../../components/ui/Button.astro";
import Icon from "../../components/ui/Icon.astro";
import { t } from "../../i18n";
import { bookName } from "../../lib/book-names";
import { chapterUrl } from "../../lib/urls";
import type { VerseRange } from "../../lib/verse-range";

interface ChapterLink {
  book: Book;
  chapter: number;
}

interface Props {
  corpus: CorpusSummary;
  book: Book;
  chapter: number;
  previous: ChapterLink | null;
  next: ChapterLink | null;
  showTransliteration: boolean;
  showGrammar: boolean;
  showGloss: boolean;
  showAi?: boolean;
  withVerseRange?: boolean;
  verseRange?: VerseRange | null;
  lastVerse?: number;
}

const {
  corpus,
  book,
  chapter,
  previous,
  next,
  showTransliteration,
  showGrammar,
  showGloss,
  showAi = false,
  withVerseRange = false,
  verseRange = null,
  lastVerse = 1,
} = Astro.props;
const bookSelectId = "chapter-nav-book";
const chapterInputId = "chapter-nav-chapter";
const fromInputId = "chapter-nav-from";
const toInputId = "chapter-nav-to";
const rangeLabelId = "chapter-nav-verses";
const linkOptions = {
  transliteration: showTransliteration,
  grammar: showGrammar,
  gloss: showGloss,
  ai: showAi,
};
---

<nav class="chapter-nav" aria-label={t.chapterNavigation}>
  {previous ? (
    <a
      class="chapter-step chapter-step--prev"
      href={chapterUrl(
        corpus.id,
        previous.book.id,
        previous.chapter,
        linkOptions,
      )}
      rel="prev"
    >
      <span class="chapter-step__arrow" aria-hidden="true">
        <Icon name="chevron-left" size={18} />
      </span>
      <span class="chapter-step__text">
        <span class="chapter-step__label">{t.previous}</span>
        <span class="chapter-step__ref">
          {bookName(previous.book.id)} {previous.chapter}
        </span>
      </span>
    </a>
  ) : (
    <span class="chapter-step chapter-step--empty" aria-hidden="true" />
  )}

  <form class="chapter-jump" action="/read" method="get">
    <input type="hidden" name="corpus" value={corpus.id} />
    {showTransliteration ? (
      <input type="hidden" name="translit" value="1" />
    ) : null}
    {showGrammar ? <input type="hidden" name="grammar" value="1" /> : null}
    {showGloss ? <input type="hidden" name="gloss" value="1" /> : null}
    {showAi ? <input type="hidden" name="ai" value="1" /> : null}

    <div class="chapter-jump__field chapter-jump__book">
      <label class="chapter-jump__label" for={bookSelectId}>
        {t.bookLabel}
      </label>
      <select id={bookSelectId} name="book">
        {corpus.books.map((item) => (
          <option value={item.id} selected={item.id === book.id}>
            {bookName(item.id)}
          </option>
        ))}
      </select>
    </div>

    <div class="chapter-jump__field chapter-jump__chapter">
      <label class="chapter-jump__label" for={chapterInputId}>
        {t.chapterLabel}
      </label>
      <input
        id={chapterInputId}
        type="number"
        name="chapter"
        value={chapter}
        min="1"
        max="150"
        inputmode="numeric"
        required
      />
    </div>

    {withVerseRange ? (
      <div class="chapter-jump__field chapter-jump__verses">
        <span class="chapter-jump__label" id={rangeLabelId}>
          {t.verseRangeLabel}
        </span>
        <div
          class="chapter-jump__range"
          role="group"
          aria-labelledby={rangeLabelId}
        >
          <label class="visually-hidden" for={fromInputId}>
            {t.verseFromLabel}
          </label>
          <input
            id={fromInputId}
            type="number"
            name="from"
            value={verseRange ? String(verseRange.from) : undefined}
            min="1"
            max={lastVerse}
            inputmode="numeric"
            placeholder="1"
          />
          <span aria-hidden="true">–</span>
          <label class="visually-hidden" for={toInputId}>
            {t.verseToLabel}
          </label>
          <input
            id={toInputId}
            type="number"
            name="to"
            value={verseRange ? String(verseRange.to) : undefined}
            min="1"
            max={lastVerse}
            inputmode="numeric"
            placeholder={String(lastVerse)}
          />
        </div>
      </div>
    ) : null}

    <Button type="submit" size="sm">
      {t.goButton}
    </Button>
  </form>
  {next ? (
    <a
      class="chapter-step chapter-step--next"
      href={chapterUrl(corpus.id, next.book.id, next.chapter, linkOptions)}
      rel="next"
    >
      <span class="chapter-step__text">
        <span class="chapter-step__label">{t.next}</span>
        <span class="chapter-step__ref">
          {bookName(next.book.id)} {next.chapter}
        </span>
      </span>
      <span class="chapter-step__arrow" aria-hidden="true">
        <Icon name="chevron-right" size={18} />
      </span>
    </a>
  ) : (
    <span class="chapter-step chapter-step--empty" aria-hidden="true" />
  )}
</nav>
