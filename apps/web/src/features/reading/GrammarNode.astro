---
import type {
  FeatureDefinition,
  GrammarGroupDefinition,
  GrammarObject,
  TextDirection,
  Word,
} from "@aletheia-codex/contracts";
import { t } from "../../i18n";
import { featureValueLabel } from "../../lib/grammar-labels";
import WordToken from "./WordToken.astro";
import GrammarNode from "./GrammarNode.astro";

interface Props {
  node:
    | {
        kind: "object";
        object: GrammarObject;
        color: string | null;
        children: GrammarNodeItem[];
      }
    | {
        kind: "words";
        words: Word[];
      };
  groups: GrammarGroupDefinition[];
  features: FeatureDefinition[];
  language: string;
  direction: TextDirection;
  translitLang: string;
  showTransliteration: boolean;
  showGloss: boolean;
  showPanel?: boolean;
  verseScriptClass: string;
}

type GrammarNodeItem = Props["node"];

const {
  node,
  groups,
  features,
  language,
  direction,
  translitLang,
  showTransliteration,
  showGloss,
  showPanel = true,
  verseScriptClass,
} = Astro.props;

function rangeLabel(object: GrammarObject): string {
  if (object.verseStart === object.verseEnd) {
    return `${t.verseShort} ${object.verseStart}`;
  }
  return `${t.versesShort} ${object.verseStart}–${object.verseEnd}`;
}
---

{node.kind === "words" ? (
  <div
    class:list={[
      "grammar-words",
      verseScriptClass,
      { "grammar-words--gloss": showGloss },
    ]}
    dir={direction}
    lang={language}
  >
    {node.words.map((word) => (
      <WordToken
        word={word}
        lang={language}
        direction={direction}
        translitLang={translitLang}
        showTransliteration={showTransliteration}
        showGloss={showGloss}
        showPanel={showPanel}
        groups={groups}
        features={features}
      />
    ))}
  </div>
) : (
  <div
    class={`grammar-node grammar-node--${node.object.level}`}
    style={`--level-color: ${node.color ?? "var(--line-strong)"}`}
    data-level={node.object.level}
    data-object-id={node.object.id}
  >
    <p class="grammar-node__head">
      <span class="grammar-node__badge">{node.object.label}</span>
      <span class="grammar-node__ref">{rangeLabel(node.object)}</span>
    </p>
    {node.object.features.length > 0 ? (
      <p class="grammar-node__features">
        {node.object.features.map((feature) => (
          <span class="grammar-node__feature">
            <span class="grammar-node__feature-label">{feature.label}</span>{" "}
            <bdi title={feature.value}>{featureValueLabel(feature)}</bdi>
          </span>
        ))}
      </p>
    ) : null}
    {node.children.map((child) => (
      <GrammarNode
        node={child}
        groups={groups}
        features={features}
        language={language}
        direction={direction}
        translitLang={translitLang}
        showTransliteration={showTransliteration}
        showGloss={showGloss}
        showPanel={showPanel}
        verseScriptClass={verseScriptClass}
      />
    ))}
  </div>
)}
