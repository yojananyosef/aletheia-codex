---
import { t } from "../i18n";
import BaseLayout from "../layouts/BaseLayout.astro";

const sections = [
  [t.privacyAccountTitle, t.privacyAccountText],
  [t.privacyHistoryTitle, t.privacyHistoryText],
  [t.privacyAiTitle, t.privacyAiText],
  [t.privacyCookiesTitle, t.privacyCookiesText],
  [t.privacyDeleteTitle, t.privacyDeleteText],
  [t.privacyContactTitle, t.privacyContactText],
] as const;
---

<BaseLayout
  title={`${t.privacyTitle} — ${t.appName}`}
  description={t.privacyIntro}
>
  <main id="main" class="page">
    <div class="wrap prose-page">
      <p class="eyebrow">{t.appName}</p>
      <h1>{t.privacyTitle}</h1>
      <p class="prose-page__intro">{t.privacyIntro}</p>

      {sections.map(([title, text]) => (
        <section class="prose-page__section">
          <h2>{title}</h2>
          <p>{text}</p>
        </section>
      ))}

      <a class="button button--primary" href="/">
        {t.privacyBack}
      </a>
    </div>
  </main>
</BaseLayout>
