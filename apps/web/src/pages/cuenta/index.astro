---
import Alert from "../../components/ui/Alert.astro";
import Button from "../../components/ui/Button.astro";
import AccountShell from "../../features/account/AccountShell.astro";
import { t } from "../../i18n";
import BaseLayout from "../../layouts/BaseLayout.astro";
import { countAnalyses, loginUrl } from "../../lib/auth";
import {
  aiAvailable,
  getAiConfig,
  getAiQuotaStatus,
  type RateLimitStatus,
} from "../../lib/ai";
import { formatDate, formatDateTime } from "../../lib/date-format";

const user = Astro.locals.user;
if (!user) {
  return Astro.redirect(loginUrl("/cuenta"), 303);
}

const supabase = Astro.locals.supabase;
let total = 0;
let latest: string | null = null;
let statsError = false;

if (supabase) {
  try {
    const stats = await countAnalyses(supabase, user.id);
    total = stats.total;
    latest = stats.latest;
  } catch (error) {
    statsError = true;
    console.error(
      `[account] no se pudieron leer las estadísticas: ${
        error instanceof Error ? error.message : String(error)
      }`,
    );
  }
}

const email = user.email ?? "—";
const created = Astro.url.searchParams.get("created") === "1";
const confirmed = Astro.url.searchParams.get("confirmado") === "1";
const aiConfig = getAiConfig();

let quota: RateLimitStatus | null = null;
let quotaError = false;
if (aiAvailable()) {
  try {
    quota = await getAiQuotaStatus(user.id);
  } catch (error) {
    quotaError = true;
    console.error(
      `[account] no se pudo leer la cuota de IA: ${
        error instanceof Error ? error.message : String(error)
      }`,
    );
  }
}
---

<BaseLayout
  title={`${t.authAccountTitle} — ${t.appName}`}
  description={t.authAccountIntro}
  robots="noindex, nofollow"
>
  <AccountShell
    title={t.authAccountTitle}
    intro={t.authAccountIntro}
    active="overview"
    email={email}
  >
    {created ? (
      <Alert variant="success" class="account-notice">
        <p>{t.authCreated}</p>
      </Alert>
    ) : null}
    {confirmed ? (
      <Alert variant="success" class="account-notice">
        <p>{t.authEmailConfirmed}</p>
      </Alert>
    ) : null}
    {statsError ? (
      <Alert variant="destructive" class="account-notice">
        <p>{t.authGenericError}</p>
      </Alert>
    ) : null}

    <dl class="account-facts">
      <div class="account-fact">
        <dt>{t.authAccountEmail}</dt>
        <dd>{email}</dd>
      </div>
      <div class="account-fact">
        <dt>{t.authAccountSince}</dt>
        <dd>{formatDate(user.created_at)}</dd>
      </div>
      <div class="account-fact">
        <dt>{t.authAccountAnalyses}</dt>
        <dd>{total}</dd>
      </div>
      <div class="account-fact">
        <dt>{t.authAccountLastAnalysis}</dt>
        <dd>{latest ? formatDateTime(latest) : t.authAccountNoAnalyses}</dd>
      </div>
    </dl>

    <div class="account-actions">
      <Button href="/cuenta/historial">{t.authAccountHistory}</Button>
      <Button href="/cuenta/contrasena" variant="outline">
        {t.authAccountPasswordNav}
      </Button>
      <Button href="/privacidad" variant="ghost">
        {t.authAccountPrivacyNav}
      </Button>
    </div>

    {quota ? (
      <section class="account-quota" aria-labelledby="account-quota-title">
        <p class="account-quota__value">
          <strong>{quota.remaining}</strong>
          <span>/ {quota.limit}</span>
        </p>
        <div class="account-quota__copy">
          <h2 id="account-quota-title">{t.aiQuotaRemaining}</h2>
          <p>
            {t.aiQuotaRemainingText
              .replace("{remaining}", String(quota.remaining))
              .replace("{daily}", String(quota.limit))
              .replace("{burst}", String(aiConfig.perUserBurst))}
          </p>
          <p class="account-quota__reset">
            {t.aiQuotaResetText.replace(
              "{date}",
              formatDateTime(quota.resetAt),
            )}
          </p>
        </div>
      </section>
    ) : (
      <div class="account-note">
        <h2>{t.aiQuotaTitle}</h2>
        <p>
          {t.aiQuotaAccountText
            .replace("{daily}", String(aiConfig.perUserDaily))
            .replace("{burst}", String(aiConfig.perUserBurst))}
        </p>
        {quotaError ? <p>{t.aiQuotaStatusError}</p> : null}
      </div>
    )}
  </AccountShell>
</BaseLayout>
