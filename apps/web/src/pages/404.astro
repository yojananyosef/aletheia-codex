---
import BaseLayout from "../layouts/BaseLayout.astro";
import { t } from "../i18n";

Astro.response.status = 404;
Astro.response.statusText = "No encontrado";
---

<BaseLayout
  title={`${t.notFoundTitle} — ${t.appName}`}
  description={t.notFoundText}
>
  <main id="main" class="page">
    <div class="wrap not-found">
      <p class="eyebrow">404</p>
      <h1>{t.notFoundTitle}</h1>
      <p class="not-found__text">{t.notFoundText}</p>
      <div class="not-found__actions">
        <a class="button button--primary" href="/">
          Volver a la selección
        </a>
        <a class="not-found__link" href="/#ediciones">
          Explorar las ediciones
        </a>
      </div>
      <p class="not-found__note">ETCBC4 · Nestlé 1904 · Vulgata</p>
    </div>
  </main>
</BaseLayout>
