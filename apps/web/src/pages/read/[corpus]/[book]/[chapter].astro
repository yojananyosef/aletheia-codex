---
import { NotFoundError, type Book } from "@bibleol/contracts";
import BaseLayout from "../../../../layouts/BaseLayout.astro";
import CorpusTabs from "../../../../features/navigation/CorpusTabs.astro";
import ChapterNavigation from "../../../../features/navigation/ChapterNavigation.astro";
import GrammarView from "../../../../features/reading/GrammarView.astro";
import VerseList from "../../../../features/reading/VerseList.astro";
import { t } from "../../../../i18n";
import { bookName } from "../../../../lib/book-names";
import { getReader } from "../../../../lib/reader";
import { chapterUrl } from "../../../../lib/urls";

interface ChapterLink {
  book: Book;
  chapter: number;
}

const corpusId = Astro.params.corpus;
const bookId = Astro.params.book;
const chapterParam = Astro.params.chapter;

if (!corpusId || !bookId || !chapterParam || !/^\d+$/.test(chapterParam)) {
  return Astro.rewrite("/404");
}

const chapterNumber = Number(chapterParam);
const reader = getReader();

let data;
try {
  data = reader.getChapter(corpusId, bookId, chapterNumber);
} catch (error) {
  if (error instanceof NotFoundError) {
    return Astro.rewrite("/404");
  }
  throw error;
}

const { corpus, book, verses, grammar } = data;
const books = corpus.books;
const bookIndex = books.findIndex((item) => item.id === book.id);

let previous: ChapterLink | null = null;
if (chapterNumber > 1) {
  previous = { book, chapter: chapterNumber - 1 };
} else if (bookIndex > 0) {
  const previousBook = books[bookIndex - 1]!;
  previous = { book: previousBook, chapter: previousBook.chapters };
}

let next: ChapterLink | null = null;
if (chapterNumber < book.chapters) {
  next = { book, chapter: chapterNumber + 1 };
} else if (bookIndex >= 0 && bookIndex < books.length - 1) {
  const nextBook = books[bookIndex + 1]!;
  next = { book: nextBook, chapter: 1 };
}

const showTransliteration = Astro.url.searchParams.get("translit") === "1";
const showGrammar = Astro.url.searchParams.get("grammar") === "1";
const showGloss =
  corpus.gloss !== null && Astro.url.searchParams.get("gloss") === "1";

const corpusTabs = reader
  .listCorpora()
  .map((item) => {
    const matchingBook = item.books.find((entry) => entry.id === book.id);
    const targetBook = matchingBook ?? item.books[0];
    if (!targetBook) {
      return null;
    }
    return {
      id: item.id,
      title: item.title,
      languageName: item.languageName,
      href: chapterUrl(
        item.id,
        targetBook.id,
        matchingBook ? Math.min(chapterNumber, targetBook.chapters) : 1,
        {
          transliteration: showTransliteration && item.hasTransliteration,
          grammar: showGrammar,
          gloss: showGloss && item.gloss !== null,
        },
      ),
    };
  })
  .filter((item) => item !== null);

function toggleHref(key: "translit" | "grammar" | "gloss"): string {
  const params = new URLSearchParams(Astro.url.searchParams);
  if (params.get(key) === "1") {
    params.delete(key);
  } else {
    params.set(key, "1");
  }
  const query = params.toString();
  return query ? `${Astro.url.pathname}?${query}` : Astro.url.pathname;
}

const wordFeatures =
  corpus.levels.find((level) => level.key === "word")?.features ?? [];
const translitLang = `${corpus.language}-Latn`;
const pageTitle = `${bookName(book.id)} ${chapterNumber} · ${corpus.title} — ${t.appName}`;
const meta = `${corpus.version ? `${t.edition} ${corpus.version} · ` : ""}${verses.length} ${t.versesCount}`;
---

<BaseLayout
  title={pageTitle}
  description={`${bookName(book.id)} ${chapterNumber}, ${corpus.title}. ${t.grammarHint}`}
>
  <main id="main" class="reading-page">
    <div class="wrap">
      <CorpusTabs items={corpusTabs} activeId={corpus.id} />

      <header class="reading-header">
        <p class="eyebrow">
          {corpus.title} · {corpus.languageName}
        </p>
        <h1 class="reading-title">
          {bookName(book.id)}{" "}
          <span class="reading-title__chapter">{chapterNumber}</span>
        </h1>
        <p class="reading-header__meta">{meta}</p>
      </header>

      <ChapterNavigation
        corpus={corpus}
        book={book}
        chapter={chapterNumber}
        previous={previous}
        next={next}
        position="top"
        showTransliteration={showTransliteration}
        showGrammar={showGrammar}
        showGloss={showGloss}
      />

      <div class="reading-tools">
        <p class="reading-tools__hint">
          {showGrammar ? t.grammarModeHint : t.grammarHint}
        </p>
        <div class="reading-tools__links">
          <a
            class:list={["tool-link", { "tool-link--active": showGrammar }]}
            href={toggleHref("grammar")}
          >
            {showGrammar ? t.hideGrammar : t.showGrammar}
          </a>
          {corpus.hasTransliteration ? (
            <a
              class:list={[
                "tool-link",
                { "tool-link--active": showTransliteration },
              ]}
              href={toggleHref("translit")}
            >
              {showTransliteration
                ? t.hideTransliteration
                : t.showTransliteration}
            </a>
          ) : null}
          {corpus.gloss !== null ? (
            <a
              class:list={["tool-link", { "tool-link--active": showGloss }]}
              href={toggleHref("gloss")}
            >
              {showGloss ? t.hideGloss : t.showGloss}
            </a>
          ) : null}
        </div>
      </div>

      {showGrammar ? (
        <GrammarView
          verses={verses}
          objects={grammar.objects}
          levels={corpus.levels}
          groups={corpus.groups}
          features={wordFeatures}
          language={corpus.language}
          direction={corpus.direction}
          translitLang={translitLang}
          showTransliteration={showTransliteration}
          showGloss={showGloss}
        />
      ) : (
        <VerseList
          verses={verses}
          language={corpus.language}
          direction={corpus.direction}
          translitLang={translitLang}
          showTransliteration={showTransliteration}
          showGloss={showGloss}
          groups={corpus.groups}
          features={wordFeatures}
        />
      )}

      <ChapterNavigation
        corpus={corpus}
        book={book}
        chapter={chapterNumber}
        previous={previous}
        next={next}
        position="bottom"
        showTransliteration={showTransliteration}
        showGrammar={showGrammar}
        showGloss={showGloss}
      />
    </div>
  </main>
</BaseLayout>
