# Opcional: ruta alternativa a los datos generados.
# BIBLEOL_DATA_DIR=./data

# Asistente de IA (opcional).
# Requiere un servidor SSR; la instantánea de GitHub Pages no incluye esta
# función porque no tiene backend.
# OPENROUTER_API_KEY=sk-or-v1-...
# AI_ENABLED=1
# AI_MODEL=google/gemma-4-26b-a4b-it:free
# AI_FALLBACK_MODELS=nvidia/nemotron-3.5-lightning:free,nvidia/nemotron-3-ultra-550b-a55b:free
# AI_BASE_URL=https://openrouter.ai/api/v1
# AI_SITE_URL=https://ejemplo.org
# AI_TIMEOUT_MS=120000
# AI_TEMPERATURE=0.3
# AI_MAX_VERSES=80
# AI_MAX_PROMPT_CHARS=120000
# AI_MAX_OUTPUT_TOKENS=2500
# AI_PER_USER_DAILY=15
# AI_PER_USER_BURST=3
# AI_GLOBAL_DAILY=40
# AI_MAX_CONCURRENT=3
# AI_CACHE_TTL_DAYS=30
# AI_REASONING=0
# AI_TRUST_PROXY=0
# AI_IP_SALT=cambie-este-valor-por-un-secreto-largo
# Ruta absoluta recomendada. Si es relativa, se resuelve desde el directorio
# de ejecución del servidor.
# BIBLEOL_AI_DB=/var/lib/bibleol/ai.sqlite

# Upstash Redis (opcional; en Vercel lo configura la integración).
# Si existe, se usa para caché y límites compartidos entre instancias.
# KV_REST_API_URL=
# KV_REST_API_TOKEN=
